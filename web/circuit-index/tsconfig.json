{
  // Typecheck: `cd web && npx tsc -p circuit-index/tsconfig.json --noEmit`.
  // The scripts run under tsx (node), so node types replace the site's vite/client types.
  "extends": "../tsconfig.json",
  "compilerOptions": { "types": ["node"], "noEmit": true },
  "include": ["./*.ts", "./__tests__/*.ts", "../src/core", "../src/pages/walker/possible.ts", "../src/pages/walker/walk.ts"]
}
