{
  // Typecheck for the classification scripts: `cd web && npx tsc -p circuit-classes/tsconfig.json --noEmit`.
  // They run under tsx (node), so node types replace the site's vite/client types.
  "extends": "../tsconfig.json",
  "compilerOptions": { "types": ["node"], "noEmit": true },
  "include": ["./*.ts", "../src/core"]
}
